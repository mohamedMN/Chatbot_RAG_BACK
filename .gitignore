# --- Project data (big, generated, or local) ---
# Keep repo clean: do not commit raw docs, generated chunks/embeddings, FAISS, or runtime copies.
data/raw/**
data/processed/**
data/index/**
data/runtime/**

# But allow placeholder keepers so the folders exist in git
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep
!data/runtime/.gitkeep

# --- Workspaces (ephemeral sandboxes) ---
**/workspaces/**
**/uploads/**

